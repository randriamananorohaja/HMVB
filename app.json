{
  "expo": {
    "name": "HMVB",
    "slug": "hmvb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoHMVB.png",
    "scheme": "hmvb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HMVB a besoin de la caméra pour scanner les QR codes des joueurs et prendre des photos d'avatar.",
        "NSPhotoLibraryUsageDescription": "HMVB a besoin d'accéder à vos photos pour l'avatar des joueurs."
      }
    },
    "android": {
      "package": "com.hmvb.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoHMVB.png",
        "backgroundColor": "#0A2540",
        "backgroundImage": "./assets/images/logoHMVB.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logoHMVB.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoHMVB.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "VolleyTeam a besoin de la caméra pour scanner les QR codes de présence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VolleyTeam a besoin d'accéder à vos photos pour l'avatar des joueurs.",
          "cameraPermission": "VolleyTeam a besoin de la caméra pour prendre une photo d'avatar."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa11c744-328f-4177-a9fd-3d45ce865f01"
      }
    }
  }
}
