{
  "expo": {
    "name": "VolleyTeam",
    "slug": "volleyteam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "volleyteam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VolleyTeam a besoin de la cam\u00e9ra pour scanner les QR codes et prendre des photos d'avatar.",
        "NSPhotoLibraryUsageDescription": "VolleyTeam a besoin d'acc\u00e9der \u00e0 vos photos pour l'avatar des joueurs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "VolleyTeam a besoin de la cam\u00e9ra pour scanner les QR codes de pr\u00e9sence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VolleyTeam a besoin d'acc\u00e9der \u00e0 vos photos pour l'avatar des joueurs.",
          "cameraPermission": "VolleyTeam a besoin de la cam\u00e9ra pour prendre une photo d'avatar."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}